        "\n",
        "import pandas as pd\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "# Create the dataset\n",
        "data = {\n",
        "    'Name': ['Anu', 'Ravi', 'Priya', 'Kiran', 'Meena', 'Arjun'],\n",
        "    'Age': [21, 22, None, 23, 21, None],\n",
        "    'Salary': [25000, None, 30000, 28000, None, 32000],\n",
        "    'Department': ['CSE', 'ECE', 'CSE', None, 'ISE', 'ECE'],\n",
        "    'City': ['Mysore', 'Bangalore', 'Mysore', 'Hubli', 'Bangalore', 'Mysore']\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Display missing values\n",
        "print(\"Missing Values:\")\n",
        "print(df.isnull())\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# Mean Imputation\n",
        "df['Age'] = df['Age'].fillna(df['Age'].mean())\n",
        "\n",
        "print(\"\\nMean Age:\", df['Age'].mean())\n",
        "print(\"\\nAfter Mean Imputation:\")\n",
        "print(df)\n",
        "\n",
        "# Median Imputation\n",
        "df['Salary'] = df['Salary'].fillna(df['Salary'].median())\n",
        "\n",
        "print(\"\\nAfter Median Imputation:\")\n",
        "print(df)\n",
        "\n",
        "# Forward Fill\n",
        "df['Department'] = df['Department'].ffill()\n",
        "\n",
        "print(\"\\nAfter Forward Fill:\")\n",
        "print(df)\n",
        "\n",
        "# Label Encoding\n",
        "encoder = LabelEncoder()\n",
        "df['Department_Encoded'] = encoder.fit_transform(df['Department'])\n",
        "\n",
        "print(\"\\nAfter Label Encoding:\")\n",
        "print(df)\n",
        "print(\"Department Classes:\", encoder.classes_)\n",
        "\n",
        "# One-Hot Encoding\n",
        "encoded_df = pd.get_dummies(\n",
        "    df.drop(columns=['Department_Encoded']),\n",
        "    columns=['Department']\n",
        ")\n",
        "\n",
        "print(\"\\nAfter One-Hot Encoding:\")\n",
        "print(encoded_df)\n",
        "\n",
        "# One-Hot Encoding with 0 and 1\n",
        "encoded_df = pd.get_dummies(\n",
        "    df.drop(columns=['Department_Encoded']),\n",
        "    columns=['Department'],\n",
        "    dtype=int\n",
        ")\n",
        "\n",
        "print(\"\\nOne-Hot Encoding with 0 and 1:\")\n",
        "print(encoded_df)\n"
